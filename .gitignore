# Lock files. Neither is tracked, so a fresh machine gets current versions
# rather than pinned ones — remove these lines if you'd rather pin.
Brewfile.lock.json
config/nvim/lazy-lock.json

# Backups created by install.sh when it replaces a real file with a symlink
*.bak

# Karabiner writes these next to karabiner.json (the whole dir is linked)
config/karabiner/automatic_backups/
config/karabiner/assets/

# Claude Code: shared project settings and hooks are tracked; personal
# overrides (settings.local.json) are not
.claude/*
!.claude/settings.json
!.claude/hooks/

# macOS
.DS_Store

# Python bytecode (the keyboardio scripts disable it, but just in case)
__pycache__/
