#!/usr/bin/env python3
"""How often each Hammerspoon shortcut was pressed, and which never were.

Reads the usage log Hammerspoon appends a line to on every bound key press
(~/.local/state/hammerspoon/usage.tsv: time, key, description, tab-separated;
see logUsage in config/hammerspoon/init.lua). The log stays on this machine
and out of the repo.

Bindings are counted by description, not key, so a binding keeps its history
when it moves to another key; Hyper+` and Hyper+; share one. "Never pressed"
compares against the live cheatsheet from Hammerspoon (hyperCheatsheetExport),
so it lists only what's bound today. Karabiner rules aren't logged (Karabiner
records nothing when a rule fires), nor the launcher's second key.

Usage:
    hyper-stats              # the last 30 days
    hyper-stats --days 7
    hyper-stats --all        # since the log began
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
from collections import Counter
from datetime import datetime, timedelta

LOG = os.path.expanduser("~/.local/state/hammerspoon/usage.tsv")


def read_log(since):
    """(Counter of description → presses, {description: latest key}, first day)."""
    counts, keys, first = Counter(), {}, None
    with open(LOG, encoding="utf-8") as f:
        for line in f:
            parts = line.rstrip("\n").split("\t")
            if len(parts) != 3:
                continue
            time, key, desc = parts
            if first is None:
                first = time[:10]
            if since and time < since:
                continue
            counts[desc] += 1
            keys[desc] = key
    return counts, keys, first


def live_bindings():
    """[(key label, description)] from the running Hammerspoon, Karabiner's
    section left out; None when Hammerspoon doesn't answer."""
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, "bindings.json")
        # </dev/null: hs reads commands from stdin when it isn't a terminal and
        # would wait forever. The alarm is a safety net (macOS has no `timeout`).
        subprocess.run(
            ["perl", "-e", "alarm 10; exec @ARGV", "hs", "-c", f"return hyperCheatsheetExport('{path}')"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        try:
            with open(path, encoding="utf-8") as f:
                sections = json.load(f)["sections"]
        except (OSError, ValueError, KeyError):
            return None
    return [(e["key"], e["desc"]) for s in sections if s["name"] != "Karabiner" for e in s["entries"]]


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--days", type=int, default=30, help="look back this many days (default 30)")
    parser.add_argument("--all", action="store_true", help="the whole log")
    args = parser.parse_args()

    if not os.path.exists(LOG):
        sys.exit(f"no usage log yet at {LOG} — press a Hyper key first")
    since = None if args.all else (datetime.now() - timedelta(days=args.days)).strftime("%Y-%m-%dT00:00:00")
    counts, keys, first = read_log(since)
    bindings = live_bindings()
    labels = {desc: key for key, desc in bindings or []}

    span = f"since {first}" if args.all or (first and since and first > since[:10]) else f"last {args.days} days"
    total = sum(counts.values())
    print(f"{total} press{'' if total == 1 else 'es'}, {span}\n")
    width = max((len(labels.get(d, keys[d])) for d in counts), default=0)
    for desc, n in counts.most_common():
        print(f"{n:6}  {labels.get(desc, keys[desc]):<{width}}  {desc}")

    if bindings is None:
        print("\n(Hammerspoon didn't answer — can't list the bindings never pressed)")
        return
    unused = [(key, desc) for key, desc in bindings if desc not in counts]
    if unused:
        print("\nNever pressed:")
        width = max(len(key) for key, _ in unused)
        for key, desc in unused:
            print(f"        {key:<{width}}  {desc}")


if __name__ == "__main__":
    main()
