# Shared defaults — host-specific entries go in ~/.ssh/config.local
Include ~/.ssh/config.local

Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
    # Reuse one connection per host: repeat git fetch/push skips the ~1 s
    # handshake. If it hangs after sleep or a network change: ssh -O exit <host>
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    Compression yes
