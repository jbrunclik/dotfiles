#!/usr/bin/env python3
"""Generate the Model 100's Hyper layer and LED colors from the dotfiles.

What it sets, starting from the keyboard's current state:

  * Layer 3 "Hyper": every plain key of the base layer sends Hyper + itself.
    The Hyper key (base layer, right thumb-cluster) becomes "hold for layer
    3", so holding it lights that layer — chords behave exactly as before.
  * Prog → F19 (Messages toggle in Hammerspoon).
  * Layer 2 "Function" (hold the left palm key): the stock layer, cleaned up
    — media keys on WASD, Fn+,/. switch tabs (FN_KEYS).
  * Colors (Colormap LED mode, Catppuccin Mocha): the Hyper layer is colored
    by cheatsheet section, so the keyboard shows what's bound; unbound keys
    stay dark. Base is dim with the single-purpose keys marked; the Fn and
    Numpad layers light only their own keys.
  * Layer names and a calmer LED brightness.

The Hyper bindings come live from Hammerspoon (hyperCheatsheetExport — the
same data as the hold-Hyper overlay), so re-run after adding a binding.

Dry run by default: prints the plan. --apply writes it to the keyboard over
the Focus protocol (as Chrysalis does) and reads every value back to verify;
if a write fails or doesn't read back, it restores the values it snapshotted.
Afterwards run keyboardio-backup and commit. Quit Chrysalis first.

Usage:
    keyboardio-layers            # show what would change
    keyboardio-layers --apply
"""

import json
import os
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
repo = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(repo, "lib"))
from kaleidoscope_focus import Keyboard  # noqa: E402

APPLY = "--apply" in sys.argv[1:]
LAYERS, KEYS = 8, 64
# The Numpad lives on layer 4, not the stock layer 1: the firmware's stock
# NumPad plugin is tied to layer 1 and, while it's active, forces the numpad
# keys to its own color (off, in this firmware) — the color map can't light them.
STOCK_NUMPAD, FN, HYPER, NUMPAD = 1, 2, 3, 4
BASE = 0
NAMES = ["QWERTY", "Unused", "Function", "Hyper", "Numpad"]
BRIGHTNESS = 200  # of 255; LEDs under keycaps are hard to see much lower

# The color map is indexed by LED, not by key: the LEDs are wired in a
# different order. KEY_LED[row][col] is the LED under each key — the same table
# Chrysalis uses for the Model 100's colormap editor.
KEY_LED = [
    [3, 4, 11, 12, 19, 20, 26, 27, 36, 37, 43, 44, 51, 52, 59, 60],
    [2, 5, 10, 13, 18, 21, 25, 28, 35, 38, 42, 45, 50, 53, 58, 61],
    [1, 6, 9, 14, 17, 22, 24, 29, 34, 39, 41, 46, 49, 54, 57, 62],
    [0, 7, 8, 15, 16, 23, 31, 30, 33, 32, 40, 47, 48, 55, 56, 63],
]

# Kaleidoscope key encoding (raw 16-bit): plain keys are the USB HID usage,
# optionally with modifier flags in the high byte; layer keys are synthetic.
TRANSPARENT = 65535
CTRL, LALT, SHIFT, GUI = 0x01, 0x02, 0x08, 0x10
HYPER_MODS = (CTRL | LALT | SHIFT | GUI) << 8
HYPER_KEY = ((CTRL | LALT | SHIFT) << 8) | 0xE3  # Ctrl+Alt+Shift + Left Cmd
SHIFT_TO_LAYER = 0x4400 + 42                     # + layer (left palm Fn = layer 2 = 17452)
LOCK_LAYER = 0x4400                              # + layer (stock Num key = layer 1 = 0x4401)
F18, F19 = 0x6D, 0x6E
SCREENSHOT = ((SHIFT | GUI) << 8) | 0x21         # Cmd+Shift+4, the butterfly key (Shottr)
PROG = 0                                         # row 0, col 0 of the base layer

# Palette: 24 RGB colors (Chrysalis reads it in threes), but the color map
# stores 4 bits per key, so only the first 16 are reachable. Catppuccin
# Mocha's color families, saturated: its pastels read as near-white on LEDs.
PALETTE = [
    (0, 0, 0),        # 0  off
    (150, 40, 255),   # 1  mauve     Layouts
    (0, 70, 255),     # 2  blue      Windows, Zoom, volume keys
    (0, 255, 40),     # 3  green     Apps, numpad digits, mouse keys
    (255, 0, 40),     # 4  red       Zoom (also the Any key)
    (0, 255, 170),    # 5  teal      Messages (also the Prog key)
    (255, 190, 0),    # 6  yellow    Hammerspoon, media keys, numpad operators
    (255, 80, 0),     # 7  peach     Karabiner nav, screenshot key, brackets/symbols
    (110, 120, 255),  # 8  lavender  editing/navigation keys, anything else
    (0, 190, 255),    # 9  sky       arrows
    (255, 30, 150),   # 10 pink      F-keys, forward delete, Slack
    (140, 80, 190),   # 11 dim mauve base layer gradient, columns 0–3 (far left)
    (230, 230, 240),  # 12 white     layer keys (incl. the way out of a layer), Notion, the tab keys
    (70, 100, 190),   # 13 dim blue  base layer gradient, columns 4–7
    (50, 150, 140),   # 14 dim teal  base layer gradient, columns 8–11
    (70, 150, 80),    # 15 dim green base layer gradient, columns 12–15 (far right)
] + [(0, 0, 0)] * 8   # 16–23: unreachable from the 4-bit color map
# Base layer: a dim left-to-right gradient, so it's never a dull grey. Brightness
# of these is what reads as "softly lit" under the keycaps; much lower is invisible.
BASE_GRADIENT = [11, 13, 14, 15]
SECTION_COLORS = {"Layouts": 1, "Windows": 2, "Apps": 3, "Zoom": 4, "Messages": 5,
                  "Hammerspoon": 6, "Karabiner": 7, "Launcher": 3, "Utilities": 6}
# Hyper+1–6: each app in its own theme/brand color (keyed by the cheatsheet label)
APP_COLORS = {"Ghostty": 1,  # its Catppuccin Mocha accent, mauve
              "Dia": 6,      # yellow icon
              "Chrome": 3,   # green, from the logo
              "Slack": 10,   # aubergine, as magenta-pink
              "Notion": 12,  # black and white
              "Zoom": 2}     # Zoom blue
# Karabiner remaps by kind (matched on the rule's action text): arrows are
# their own category, the same sky as the Fn layer's arrows
KARABINER_COLORS = [("Arrow", 9), ("Page", 8), ("Word", 7), ("Line", 7),
                    ("Forward delete", 10), ("tab", 12)]

HID = {chr(65 + i): 0x04 + i for i in range(26)}
HID.update({str(i): 0x1D + i for i in range(1, 10)})
HID.update({"0": 0x27, "Tab": 0x2B, "⌫": 0x2A, ",": 0x36, ".": 0x37, "Space": 0x2C, "`": 0x35, ";": 0x33,
            "Return": 0x28})
# Not on the base layer, but the Hyper layer sends them from the left thumb
HID.update({"←": 0x50, "→": 0x4F, "↑": 0x52, "↓": 0x51})
LCTRL, LCMD, LSHIFT, BACKSPACE = 0xE0, 0xE3, 0xE1, 0x2A
# Hyper+arrows (focus a half; reading frame, restore): the base layer has no
# arrows, so the Hyper layer sends all four from the left thumb arc, outer to
# inner Ctrl ←, Backspace →, Cmd ↑, Shift ↓ — focus, the most used, on the two
# keys under the thumb's resting reach. The modifiers are idle during a
# Hyper chord, which already holds every one; Backspace gives up Hyper+⌫
# (forward delete), which stays on Fn+Backspace.
THUMB_ARROWS = {LCTRL: HID["←"], BACKSPACE: HID["→"], LCMD: HID["↑"], LSHIFT: HID["↓"]}

# Function layer: changes to the stock layer, by (row, col); None is
# transparent (the base key). Dropped: what a Mac with a trackpad never uses —
# mouse keys and warp, Home/End (they scroll, not move the cursor), Print
# Screen, Insert, Caps Lock, Fn+Space = Enter, the Menu key (it opens
# the window's menu, not the selection's). The media keys move to WASD, by
# direction: up/down volume, left/right track, X (under S) mute, F play. Fn+,/.
# send Hyper+,/. — the tab keys, as a two-hand chord (Hyper is the right palm,
# the same hand as , and .). Kept as stock: F-keys, arrows on HJKL, the
# brackets and \ | (the base layer has no [ ] \), Fn+` Tab, Fn+⌫ forward
# delete.
CONSUMER = 0x4800
MUTE, VOL_UP, VOL_DOWN = CONSUMER | 0xE2, CONSUMER | 0xE9, CONSUMER | 0xEA
NEXT_TRACK, PREV_TRACK, PLAY_PAUSE = CONSUMER | 0xB5, CONSUMER | 0xB6, CONSUMER | 0xCD
FN_KEYS = {
    (1, 2): VOL_UP, (2, 2): VOL_DOWN, (3, 2): MUTE,        # W S X
    (2, 1): PREV_TRACK, (2, 3): NEXT_TRACK, (2, 4): PLAY_PAUSE,  # A D F
    (3, 12): HYPER_MODS | HID[","], (3, 13): HYPER_MODS | HID["."],
    (0, 6): None,                                          # Caps Lock (LED key)
    (1, 4): None, (1, 5): None, (1, 6): None,              # R T Tab: right click, warp
    (2, 5): None, (2, 6): None, (3, 4): None, (3, 5): None,  # G Esc V B: warp, middle click
    (2, 0): None, (3, 0): None, (3, 1): None,              # Home End Print Screen
    (1, 8): None, (2, 9): None,                            # Space: Enter · butterfly: Menu
    (0, 9): None, (1, 9): None, (1, 10): None,             # Any Enter Y: old track keys
    (3, 10): None, (3, 11): None,                          # N M: old mute, volume down
}


def plain(k):
    """HID usage of a plain, unmodified key, else None."""
    return k if k < 0x100 else None


def is_layer_key(k):
    return 0x4400 <= k < 0x4500


def layer_color(k, base_key):
    """Color for a key on a non-base layer (Fn, Numpad, and any added later),
    by what kind of key it is. Transparent keys are dark — except where the
    base key is a layer key, which stays lit: that's the way out."""
    if k == TRANSPARENT:
        return 12 if is_layer_key(base_key) else 0
    hi, code = k >> 8, k & 0xFF
    if k in (MUTE, VOL_UP, VOL_DOWN):    # volume, apart from the track keys beside it
        return 2
    if hi == 0x48:                       # consumer: media keys
        return 6
    if hi == 0x50:                       # mouse keys
        return 3
    if hi == HYPER_MODS >> 8:            # Fn+,/.: the tab keys, white as on the Hyper layer
        return 12
    if is_layer_key(k):
        return 12
    if hi & ~0x1F:                       # macros, LED keys, …
        return 11
    if 0x3A <= code <= 0x45:             # F1–F12
        return 10
    if 0x4F <= code <= 0x52:             # arrows
        return 9
    if 0x1E <= code <= 0x27 or 0x59 <= code <= 0x62:  # digits, keypad digits
        return 3
    if 0x54 <= code <= 0x58 or code in (0x63, 0x2E, 0x37):  # keypad operators, = .
        return 6
    if code in (0x2F, 0x30, 0x31):       # [ ] \ (and with Shift: { } |)
        return 7
    return 8                             # editing / navigation


def hyper_color(section, desc):
    if section == "Apps":
        return APP_COLORS.get(desc.split(" (")[0], SECTION_COLORS["Apps"])
    if section == "Karabiner":
        return next((c for word, c in KARABINER_COLORS if word in desc), SECTION_COLORS["Karabiner"])
    return SECTION_COLORS.get(section, 8)


def hyper_bindings():
    """{HID usage: palette color} for every Hyper binding, asked live from Hammerspoon."""
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, "bindings.json")
        # </dev/null: hs reads commands from stdin when it isn't a terminal
        result = subprocess.run(["perl", "-e", "alarm 10; exec @ARGV", "hs", "-c",
                                 f"return hyperCheatsheetExport('{path}')"],
                                stdin=subprocess.DEVNULL, capture_output=True, text=True)
        if not os.path.exists(path):
            # A Lua error in the export reads very differently from "not running"
            output = (result.stderr + result.stdout).strip()
            sys.exit("no data from Hammerspoon — " + (output or "is it running?"))
        sections = json.load(open(path))["sections"]
    bound = {}
    for section in sections:
        for entry in section["entries"]:
            label = entry["key"]
            if label in ("Any", "Prog"):  # plain keys, not Hyper chords
                continue
            parts = [label] if len(label) == 1 or label in HID else label.split("/")
            for part in parts:
                if part in HID:  # Hyper+↑/↓, F-keys etc. have no key on the Hyper layer
                    bound[HID[part]] = hyper_color(section["name"], entry["desc"])
    return bound


keyboard = Keyboard()
keymap = [int(x) for x in keyboard.request("keymap.custom").split()]
colormap = [int(x) for x in keyboard.request("colormap.map").split()]
modes = keyboard.request("led.modes").split("\n")
if len(keymap) != LAYERS * KEYS or len(colormap) != LAYERS * KEYS:
    sys.exit(f"unexpected keymap/colormap size ({len(keymap)}, {len(colormap)})")
if "Colormap" not in modes:
    sys.exit("firmware has no Colormap LED mode")

base = keymap[BASE * KEYS:(BASE + 1) * KEYS]
hyper_at = [i for i, k in enumerate(base) if k == HYPER_KEY or k == SHIFT_TO_LAYER + HYPER]
if len(hyper_at) != 1:
    sys.exit("can't find the Hyper key on the base layer (Ctrl+Alt+Shift+Cmd)")
bound = hyper_bindings()

new_keymap, new_colormap = list(keymap), list(colormap)


def setkey(layer, i, value):
    new_keymap[layer * KEYS + i] = value


def setcolor(layer, i, color):
    """Color the key at position i (row * 16 + col) — stored at its LED's index."""
    new_colormap[layer * KEYS + KEY_LED[i // 16][i % 16]] = color


# Base layer: Hyper key holds the Hyper layer; Prog sends F19
setkey(BASE, hyper_at[0], SHIFT_TO_LAYER + HYPER)
setkey(BASE, PROG, F19)

# Function layer
for (row, col), k in FN_KEYS.items():
    setkey(FN, row * 16 + col, TRANSPARENT if k is None else k)

# Numpad: move layer 1 to layer 4 (once — afterwards layer 4 is the source),
# point the Num key at it, and leave layer 1 empty
stock = keymap[STOCK_NUMPAD * KEYS:(STOCK_NUMPAD + 1) * KEYS]
if set(keymap[NUMPAD * KEYS:(NUMPAD + 1) * KEYS]) == {TRANSPARENT} and set(stock) != {TRANSPARENT}:
    for i, k in enumerate(stock):
        setkey(NUMPAD, i, k)
for i in range(KEYS):
    setkey(STOCK_NUMPAD, i, TRANSPARENT)
    if base[i] == LOCK_LAYER + STOCK_NUMPAD:
        setkey(BASE, i, LOCK_LAYER + NUMPAD)

# Hyper layer: every plain non-modifier key sends Hyper + itself; the rest
# (modifiers, layer keys, F18/F19) stays transparent
for i, k in enumerate(base):
    h = plain(k)
    hyper = h is not None and h not in (0, F18, F19) and not 0xE0 <= h <= 0xE7 and i != PROG
    setkey(HYPER, i, HYPER_MODS | h if hyper else TRANSPARENT)
    if h in THUMB_ARROWS and i % 16 < 8:  # left half only
        setkey(HYPER, i, HYPER_MODS | THUMB_ARROWS[h])

# Colors
for i in range(KEYS):
    k = new_keymap[BASE * KEYS + i]
    h = plain(k)
    # Base: dim, single-purpose keys marked
    setcolor(BASE, i, {F18: 4, F19: 5}.get(h, 7 if k == SCREENSHOT else
                       12 if is_layer_key(k) else BASE_GRADIENT[(i % 16) // 4]))
    # Hyper: bound keys by what they do (the key the Hyper layer sends, which
    # isn't the base key under the thumb arrows), everything else dark
    sent = new_keymap[HYPER * KEYS + i]
    setcolor(HYPER, i, 12 if k == SHIFT_TO_LAYER + HYPER else
             bound.get(sent & 0xFF, 0) if sent != TRANSPARENT else 0)
    # Every other layer that has keys of its own: by key type
    for layer in range(LAYERS):
        if layer in (BASE, HYPER):
            continue
        keys = new_keymap[layer * KEYS:(layer + 1) * KEYS]
        setcolor(layer, i, layer_color(keys[i], k) if set(keys) != {TRANSPARENT} else 0)

if max(new_colormap) > 15:
    sys.exit("color index above 15: the color map stores 4 bits per key")

names = NAMES + [f"#{n}" for n in range(len(NAMES), LAYERS)]
plan = {
    "palette": " ".join(str(v) for rgb in PALETTE for v in rgb),
    "colormap.map": " ".join(map(str, new_colormap)),
    "keymap.custom": " ".join(map(str, new_keymap)),
    "keymap.layerNames": " ".join(f"{len(n)} {n}" for n in names) + " 0",
    "led.brightness": str(BRIGHTNESS),
    "led_mode.default": str(modes.index("Colormap")),
}

changed_keys = [i for i in range(LAYERS * KEYS) if new_keymap[i] != keymap[i]]
print(f"Hyper bindings found: {len(bound)} keys in {len(set(bound.values()))} colors")
if changed_keys:
    per_layer = {L: sum(1 for i in changed_keys if i // KEYS == L) for L in range(LAYERS)}
    print("Keymap: " + ", ".join(f"{n} keys on {NAMES[L] if L < len(NAMES) else L}"
                                 for L, n in per_layer.items() if n))
else:
    print("Keymap: already up to date")
print(f"Layer names: {', '.join(NAMES)} · LED mode: Colormap · brightness {BRIGHTNESS}/255")
if not APPLY:
    print("Dry run — nothing written. Re-run with --apply.")
    sys.exit(0)


def read_for_write(command):
    """The current value, in the form a write takes."""
    value = keyboard.request(command)
    if command == "keymap.layerNames":  # read ends with "0 size=N", a write with "0"
        return " ".join(value.split("\n")[:-1]) + " 0"
    return value


def restore(written, why):
    """Put back what was there before, newest write first; exit with why."""
    print(f"{why} — restoring the previous values…", file=sys.stderr)
    try:
        keyboard.resync()  # a cut-short write leaves the firmware mid-parse
        for command in reversed(written):
            keyboard.request(command, before[command])
        keyboard.request("led.mode", before["led_mode.default"])
        failed = [c for c in written if read_for_write(c).split() != before[c].split()]
    except SystemExit as e:  # the keyboard stopped answering
        failed = [f"all ({e})"]
    if failed:
        sys.exit(f"restore failed ({', '.join(failed)}): run keyboardio-backup --restore"
                 " (writes the committed config/keyboardio/model100.json back)")
    sys.exit("keyboard back as it was; nothing changed")


# Snapshot first, so a timeout halfway through can't leave a half-written keyboard
before = {command: read_for_write(command) for command in plan}
written = []
try:
    for command, value in plan.items():
        written.append(command)  # before the request: a timeout may have written part of it
        keyboard.request(command, value)
    keyboard.request("led.mode", plan["led_mode.default"])  # switch now, not just after replug
except SystemExit as e:
    restore(written, f"writing {written[-1]} failed ({e})")

# Verify by reading back
problems = []
for command in ("palette", "colormap.map", "keymap.custom", "led.brightness", "led_mode.default"):
    if keyboard.request(command).split() != plan[command].split():
        problems.append(command)
read_names = [line.split(" ", 1)[1] for line in keyboard.request("keymap.layerNames").split("\n")[:-1]]
if read_names != names:
    problems.append(f"keymap.layerNames ({read_names})")
if problems:
    restore(written, "these didn't read back as sent: " + ", ".join(problems))
keyboard.close()
print("Applied and verified. Now: keyboardio-backup, then commit config/keyboardio/model100.json")
