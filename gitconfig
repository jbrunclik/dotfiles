[include]
    path = ~/.gitconfig.local

[core]
    pager = delta
    # Global secret-scanning pre-commit hook. Tilde-expanded by git; assumes
    # the repo lives at ~/src/dotfiles as documented in the README.
    hooksPath = ~/src/dotfiles/config/git/hooks

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = true
    syntax-theme = Catppuccin Mocha

[push]
    autoSetupRemote = true
    # Also push annotated tags on the pushed commits (lightweight tags stay local)
    followTags = true

[pull]
    rebase = true

[fetch]
    prune = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[init]
    defaultBranch = main

[diff]
    algorithm = histogram
    # Moved lines get their own color (delta renders it), so refactors read as moves
    colorMoved = default
    # `git difftool` (alias `git dft`) shows a structural diff: difftastic
    # compares syntax trees, so reformatting and re-indenting don't show as
    # changes. delta stays the pager for everything else.
    tool = difftastic

[difftool]
    prompt = false

[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[pager]
    difftool = true

[absorb]
    # With nothing staged, `git absorb` takes every change in the working tree
    autoStageIfNothingStaged = true

[alias]
    dft = difftool

[commit]
    verbose = true

[rebase]
    autosquash = true
    autostash = true

[branch]
    sort = -committerdate

[column]
    ui = auto

[help]
    # `git stauts` asks "did you mean status?" instead of failing
    autocorrect = prompt
