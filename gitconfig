[include]
    path = ~/.gitconfig.local

[core]
    pager = delta
    # Global hooks for every repo: gitleaks on commit and push, git-lfs, then
    # each repo's own .git/hooks (config/git/hooks/dispatch). Tilde-expanded
    # by git; assumes the repo lives at ~/src/dotfiles as the README says.
    hooksPath = ~/src/dotfiles/config/git/hooks

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = true
    syntax-theme = Catppuccin Mocha

[push]
    autoSetupRemote = true
    # Also push annotated tags on the pushed commits (lightweight tags stay local)
    followTags = true
    # --force-with-lease also refuses when the remote has commits you fetched
    # but never looked at (a background fetch updates the lease without you
    # having seen them)
    useForceIfIncludes = true

[pull]
    rebase = true

[fetch]
    prune = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[init]
    defaultBranch = main

[diff]
    algorithm = histogram
    # Moved lines get their own color (delta renders it), so refactors read as moves
    colorMoved = default
    # Prefixes say what's compared: i/ index, w/ working tree, c/ commit,
    # instead of a/ and b/ everywhere (delta strips them in its file headers)
    mnemonicPrefix = true
    # `git difftool` (alias `git dft`) shows a structural diff: difftastic
    # compares syntax trees, so reformatting and re-indenting don't show as
    # changes. delta stays the pager for everything else.
    tool = difftastic

[difftool]
    prompt = false

[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[pager]
    difftool = true

[absorb]
    # With nothing staged, `git absorb` takes every change in the working tree
    autoStageIfNothingStaged = true

[alias]
    dft = difftool

[commit]
    verbose = true
    # Every commit and tag is signed with the SSH key (Verified on GitHub and
    # GitLab once its public key is uploaded there as a signing key). The key
    # path is user.signingkey in ~/.gitconfig.local — it holds the home path.
    gpgsign = true

[tag]
    gpgSign = true
    # v1.10 after v1.9, not between v1.1 and v1.2
    sort = version:refname

[gpg]
    format = ssh

[gpg "ssh"]
    # Lets `git log --show-signature` verify your own signatures locally
    allowedSignersFile = ~/.ssh/allowed_signers

[rebase]
    autosquash = true
    autostash = true
    # Stacked branches: rebasing the top branch also moves every branch that
    # points into it, so the stack stays a stack
    updateRefs = true

[branch]
    sort = -committerdate

[column]
    ui = auto

[help]
    # `git stauts` asks "did you mean status?" instead of failing
    autocorrect = prompt
