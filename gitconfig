[include]
    path = ~/.gitconfig.local

[core]
    pager = delta
    # Global secret-scanning pre-commit hook. Tilde-expanded by git; assumes
    # the repo lives at ~/src/dotfiles as documented in the README.
    hooksPath = ~/src/dotfiles/config/git/hooks

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true
    side-by-side = true
    syntax-theme = Catppuccin Mocha

[push]
    autoSetupRemote = true

[pull]
    rebase = true

[fetch]
    prune = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[init]
    defaultBranch = main

[diff]
    algorithm = histogram

[commit]
    verbose = true

[rebase]
    autosquash = true
    autostash = true

[branch]
    sort = -committerdate

[column]
    ui = auto
