#!/usr/bin/env python3
"""Keep Thaw's menu bar layout in a file you can edit.

The layout is config/thaw/layout (tracked) plus ~/.config/thaw/layout.local
(untracked, for work-only icons that shouldn't be in a public repo). Each
lists icons under [visible], [hidden] and [always-hidden], left to right, one
Thaw identifier per line (`<bundle id>:<item>`, `# name` comments are
ignored). Local entries go at the left end of their section, or right after
another icon with `<id> after <other id>`. Thaw's own control items, Control
Center and the clock are added automatically.

Thaw keeps the layout in the profile of each display (Profiles/<id>.json,
menuBarLayout.itemOrder) and restores it on a display switch and at launch.
Its savedSectionOrder (preferences, and in each profile) lags behind what's
on screen, so the profile's itemOrder and the live positions are what count.
Two limits, both Thaw's: it restores which section an icon is in, not the
order within a section, so --apply can't reorder — drag, Profiles → Update,
--capture. And it won't move an icon *into* Visible while that icon sits in
a collapsed section ("skipping the visible-bound move … parked offscreen" in
its log) — drag those once in Thaw's settings. Moves into the hidden
sections work.

The file is the default (Dell) layout. Thaw's per-display profiles override
it, and the MacBook's built-in display has its own, so on the built-in
display the compare doesn't judge and --apply refuses: it would overwrite
that profile until the next display switch.

Usage:
    thaw-layout              # compare the file with Thaw; exit 1 if they differ
    thaw-layout --capture    # write the display's Thaw profile into the file(s)
    thaw-layout --apply      # write the file into Thaw: quits and relaunches it
    thaw-layout --apply --force   # … even on the built-in display
"""

import json
import os
import plistlib
import re
import subprocess
import sys
import tempfile
import time

DOMAIN = "com.stonerl.Thaw"
REPO = os.path.dirname(os.path.realpath(__file__))
TRACKED = os.path.join(REPO, "config/thaw/layout")
LOCAL = os.path.expanduser("~/.config/thaw/layout.local")
PROFILES = os.path.expanduser("~/Library/Application Support/Thaw/Profiles")
# File section name → Thaw's key, in menu bar order (left to right)
SECTIONS = {"always-hidden": "alwaysHidden", "hidden": "hidden", "visible": "visible"}
CHEVRON = "com.stonerl.Thaw:Thaw.ControlItem.Visible"
FIXED_RIGHT = ["com.apple.controlcenter:BentoBox-0", "com.apple.controlcenter:Clock"]
AUTOMATIC = {CHEVRON, *FIXED_RIGHT}


def prefs():
    return plistlib.loads(subprocess.check_output(["defaults", "export", DOMAIN, "-"]))


def read_layout(path):
    """{file section: [(id, anchor)]} from a layout file; missing file → empty.

    anchor is the icon named by `<id> after <anchor>`, else None.
    """
    layout = {name: [] for name in SECTIONS}
    if not os.path.exists(path):
        return layout
    section = None
    with open(path) as f:
        lines = f.readlines()
    for n, raw in enumerate(lines, 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if m := re.fullmatch(r"\[([\w-]+)\]", line):
            section = m.group(1)
            if section not in SECTIONS:
                sys.exit(f"{path}:{n}: unknown section [{section}]")
        elif section is None:
            sys.exit(f"{path}:{n}: entry before any [section]")
        elif m := re.fullmatch(r"(\S+)(?:\s+after\s+(\S+))?", line):
            layout[section].append((m.group(1), m.group(2)))
        else:
            sys.exit(f"{path}:{n}: expected `<id>` or `<id> after <other id>`")
    return layout


def all_ids(layout):
    return {i for entries in layout.values() for i, _ in entries}


def wanted_order():
    """Thaw's savedSectionOrder for the tracked + local files."""
    tracked, local = read_layout(TRACKED), read_layout(LOCAL)
    order = {}
    for name, key in SECTIONS.items():
        if any(anchor for _, anchor in tracked[name]):
            sys.exit(f"{TRACKED}: `after` is for layout.local only — order the file instead")
        ids = [i for i, anchor in local[name] if anchor is None] + [i for i, _ in tracked[name]]
        for i, anchor in local[name]:
            if anchor is None:
                continue
            if anchor not in ids:
                sys.exit(f"{LOCAL}: {i} after {anchor} — no {anchor} in [{name}]"
                         " (it must be in config/thaw/layout or above this line)")
            ids.insert(ids.index(anchor) + 1, i)
        order[key] = ids
    order["visible"] = [CHEVRON] + order["visible"] + FIXED_RIGHT
    seen = {}
    for key, ids in order.items():
        for i in ids:
            if i in seen:
                sys.exit(f"{i} is listed twice ([{seen[i]}] and [{key}])")
            seen[i] = key
    return order


def write_layout(path, layout, names, header):
    with open(path, "w") as f:
        f.write(header)
        for name in SECTIONS:
            f.write(f"\n[{name}]\n")
            for i, anchor in layout[name]:
                entry = f"{i} after {anchor}" if anchor else i
                f.write(f"{entry:<62} # {names[i]}\n" if names.get(i) else f"{entry}\n")


# Live positions, read through each app's AXExtrasMenuBar (macOS 26 gives every
# status item window to Control Center, so window lists can't tell them apart).
# Thaw's own items are its dividers: always-hidden (if enabled), hidden, chevron.
LIVE_LUA = r"""
local out = {}
local function add(bundle, label, x) table.insert(out, bundle .. "\t" .. label .. "\t" .. x) end
for bundle in (BUNDLES):gmatch("[^,]+") do
    for _, app in ipairs(hs.application.applicationsForBundleID(bundle)) do
        local ax = hs.axuielement.applicationElement(app)
        ax:setTimeout(0.5)
        local ok, bar = pcall(function() return ax:attributeValue("AXExtrasMenuBar") end)
        for _, item in ipairs(ok and bar and bar:attributeValue("AXChildren") or {}) do
            local p = item:attributeValue("AXPosition")
            local label = item:attributeValue("AXIdentifier") or item:attributeValue("AXDescription") or ""
            if p then add(bundle, label, p.x) end
        end
    end
end
return table.concat(out, "\n")
"""


def ax_label(item):
    """What AX calls a Control Center item: WiFi → com.apple.menuextra.wifi."""
    special = {"BentoBox-0": "controlcenter", "WiFi": "wifi"}
    if item in special:
        return "com.apple.menuextra." + special[item]
    return "com.apple.menuextra." + re.sub(r"(?<=[a-z])(?=[A-Z])", "-", item).lower()


def live_sections(ids):
    """{id: (section key, x)} for the ids whose icon can be found on screen."""
    bundles = {i.split(":", 1)[0] for i in ids} | {DOMAIN}
    lua = LIVE_LUA.replace("BUNDLES", repr(",".join(sorted(bundles))))
    out = subprocess.run(["perl", "-e", "alarm 30; exec @ARGV", "hs", "-c", lua],
                         stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False).stdout
    extras = {}
    for row in out.splitlines():
        parts = row.split("\t")
        if len(parts) == 3:
            extras.setdefault(parts[0], []).append((parts[1], float(parts[2])))
    dividers = sorted(x for _, x in extras.get(DOMAIN, []))
    if len(dividers) < 2:
        sys.exit("can't find Thaw's dividers — is Thaw running? (and Hammerspoon, for hs)")
    chevron, always = dividers[-1], dividers[0] if len(dividers) == 3 else None
    found = {}
    for i in ids:
        bundle, item = i.split(":", 1)
        items = extras.get(bundle, [])
        if bundle == "com.apple.controlcenter":
            items = [e for e in items if e[0] == ax_label(item)]
        elif bundle == "com.apple.systemuiserver":
            items = [e for e in items if e[0] == item]
        if len(items) != 1:
            continue  # not running, or ambiguous
        x = items[0][1]
        found[i] = ("visible" if x > chevron else "alwaysHidden" if always is not None and x < always
                    else "hidden", x)
    return found


def report(order, quiet=False):
    """Print where each icon is versus where the file wants it, order within
    each section included; True if all match."""
    want = {i: key for key, ids in order.items() for i in ids if i not in AUTOMATIC}
    live = live_sections(want)
    names = prefs().get("MenuBarItemResolvedNames", {})
    key_names = {key: name for name, key in SECTIONS.items()}
    ok = True
    for i, key in want.items():
        if i not in live:
            quiet or print(f"  ?  {i} — not on screen (app not running?)")
        elif live[i][0] != key:
            ok = False
            quiet or print(f"  ✗  {i} — in [{key_names[live[i][0]]}], file says [{key_names[key]}]")
    for key, ids in order.items():
        placed = [i for i in ids if i in live and live[i][0] == key]
        on_screen = sorted(placed, key=lambda i: live[i][1])
        if on_screen != placed:
            ok = False
            label = lambda seq: ", ".join(names.get(i, i) for i in seq)  # noqa: E731
            quiet or print(f"  ✗  [{key_names[key]}] on screen: {label(on_screen)}\n"
                           f"     {' ' * len(key_names[key])}  file says: {label(placed)}")
    return ok


def hs(lua):
    # </dev/null: hs reads commands from stdin when it isn't a terminal
    return subprocess.run(["perl", "-e", "alarm 10; exec @ARGV", "hs", "-c", lua],
                          stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False).stdout.strip()


def display_profile():
    """(path, profile) of Thaw's profile for the main display, or (None, None)."""
    try:
        profiles = json.load(open(os.path.join(PROFILES, "profiles.json")))
    except FileNotFoundError:
        return None, None
    uuid = hs("return hs.screen.mainScreen():getUUID()")
    for entry in profiles:
        if entry.get("associatedDisplayUUID") == uuid:
            path = os.path.join(PROFILES, entry["id"] + ".json")
            return path, json.load(open(path))
    return None, None


def thaw_order():
    """The layout Thaw restores here: the display profile's itemOrder, else savedSectionOrder."""
    _, profile = display_profile()
    if profile:
        return profile["menuBarLayout"]["itemOrder"], profile["name"]
    return prefs()["MenuBarItemManager.savedSectionOrder"], None


def on_builtin_display():
    """True when the main screen is the MacBook's own (its Thaw profile rules)."""
    return hs("return hs.screen.mainScreen():name()").startswith("Built-in")


def quit_thaw():
    subprocess.run(["osascript", "-e", 'quit app "Thaw"'], capture_output=True, check=False)
    for _ in range(50):
        if subprocess.run(["pgrep", "-x", "Thaw"], capture_output=True, check=False).returncode:
            return
        time.sleep(0.1)
    sys.exit("Thaw didn't quit")


args = sys.argv[1:]
if args == ["--capture"]:
    current, profile_name = thaw_order()
    names = prefs().get("MenuBarItemResolvedNames", {})
    local_ids = all_ids(read_layout(LOCAL))
    known = all_ids(read_layout(TRACKED)) | local_ids
    tracked = {name: [] for name in SECTIONS}
    local = {name: [] for name in SECTIONS}
    for name, key in SECTIONS.items():
        prev, at_left = None, True  # local icons left of every tracked one need no anchor
        for i in current.get(key, []):
            if i in AUTOMATIC:
                continue
            if i in local_ids:
                local[name].append((i, None if at_left else prev))
            else:
                tracked[name].append((i, None))
                at_left = False
            prev = i
            if known and i not in known:  # first capture: everything is new
                print(f"new: {i} ({names.get(i, '?')}) → config/thaw/layout"
                      " — move it to layout.local if it's work-only")
    os.makedirs(os.path.dirname(TRACKED), exist_ok=True)
    write_layout(TRACKED, tracked, names, "# Thaw menu bar layout: `thaw-layout --apply` writes it into Thaw.\n"
                 "# Left to right within each section; work-only icons go in\n"
                 "# ~/.config/thaw/layout.local (same format, untracked).\n")
    if any(local.values()) or os.path.exists(LOCAL):
        os.makedirs(os.path.dirname(LOCAL), exist_ok=True)
        write_layout(LOCAL, local, names, "# Work-only Thaw icons, merged into config/thaw/layout: at the left\n"
                     "# end of each section, or after the icon named by `after`. Untracked.\n")
    print(f"Wrote {os.path.relpath(TRACKED, REPO)}" + (f" and {LOCAL}" if any(local.values()) else "")
          + (f" from Thaw's {profile_name} profile" if profile_name else ""))
elif args in (["--apply"], ["--apply", "--force"]):
    if on_builtin_display() and "--force" not in args:
        sys.exit("On the built-in display: --apply would overwrite the MacBook's Thaw profile\n"
                 "until the next display switch. Run it on the Dell, or add --force.")
    order = wanted_order()
    profile_path, profile = display_profile()
    quit_thaw()
    if profile:  # what Thaw restores on this display; savedSectionOrder alone gets overridden
        layout = profile["menuBarLayout"]
        layout["itemOrder"] = layout["savedSectionOrder"] = order
        layout.setdefault("itemSectionMap", {}).update({i: key for key, ids in order.items() for i in ids})
        tmp = profile_path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(profile, f, indent=2, separators=(",", " : "))
        os.replace(tmp, profile_path)
    p = prefs()
    p["MenuBarItemManager.savedSectionOrder"] = order
    if order["alwaysHidden"]:
        p["EnableAlwaysHiddenSection"] = True
    fd, path = tempfile.mkstemp(suffix=".plist")  # unpredictable name, 0600
    try:
        with os.fdopen(fd, "wb") as f:
            plistlib.dump(p, f)
        subprocess.run(["defaults", "import", DOMAIN, path], check=True)
    finally:
        os.unlink(path)
        # Relaunch even if the import failed: a quit Thaw shows every icon
        subprocess.run(["open", "-a", "Thaw"], check=False)
    print("Written; waiting for Thaw to move the icons…")
    for _ in range(10):  # Thaw settles within a few seconds; give it up to ~20
        time.sleep(2)
        try:
            if report(order, quiet=True):
                break
        except SystemExit:  # Thaw's dividers not up yet
            continue
    if report(order):
        print("Every icon is where the file says.")
    else:
        sys.exit("Some icons aren't where the file says — Thaw restores sections, not the order"
                 " within one, and won't move icons into Visible: drag those (see --help).")
elif not args:
    order = wanted_order()
    if on_builtin_display():
        print("On the built-in display, Thaw shows the MacBook's own profile; the file is the"
              " Dell layout — compare there.")
        sys.exit(0)
    saved, profile_name = thaw_order()
    # Order counts too: the file lists each section left to right
    same = all(saved.get(key, []) == ids for key, ids in order.items())
    where = f"Thaw's {profile_name} profile" if profile_name else "Thaw's saved layout"
    print(where + (" matches the file, in order." if same else
                   " differs from the file — after dragging: Profiles → Update, then --capture."))
    on_screen = report(order)
    if on_screen:
        print("Every icon on screen is where the file says.")
    sys.exit(0 if same and on_screen else 1)
else:
    print(__doc__.strip())
    sys.exit(0 if args in (["-h"], ["--help"]) else 2)
