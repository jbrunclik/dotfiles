{
    // === Theme (Catppuccin to match terminal) ===
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.iconTheme": "catppuccin-mocha",

    // === Font (Maple Mono to match terminal) ===
    "editor.fontFamily": "Maple Mono NF, monospace",
    "editor.fontSize": 15,
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "Maple Mono NF",

    // === Editor ===
    "editor.rulers": [88],
    "editor.guides.bracketPairs": true,
    "editor.stickyScroll.enabled": true,
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "trailing",
    "editor.cursorBlinking": "solid",
    "editor.linkedEditing": true,
    "editor.wordBasedSuggestions": "off",

    // === Files ===
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/*.egg-info": true,
        "**/.DS_Store": true
    },
    // node_modules is already excluded from both by default
    "files.watcherExclude": {
        "**/.venv/**": true
    },
    "search.exclude": {
        "**/.venv": true
    },

    // === Python — Pylance for type checking + IntelliSense ===
    "python.languageServer": "Pylance",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    // pytest finds tests from each project's own config; a global ["tests"]
    // broke projects laid out differently
    "python.testing.pytestEnabled": true,

    // === Python — Ruff for linting + formatting (replaces black, isort, flake8) ===
    // mypy (ms-python.mypy-type-checker) runs each project's own mypy config
    // too: the projects run it in their Makefile and CI, and Pylance's checker
    // doesn't report the same errors
    "ruff.importStrategy": "fromEnvironment",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },

    // === TypeScript / JavaScript — Prettier ===
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    // This file and other JSON with comments; Prettier keeps the comments
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
    },

    // === Shell and TOML — the same formatters as Neovim ===
    // 4-space indent and indented case branches, as Neovim formats them: the
    // extension doesn't pass the editor's indent, and shfmt's default is tabs.
    // ShellCheck (timonwong.shellcheck) lints as you type.
    "shfmt.executableArgs": ["-i", "4", "-ci"],
    "[shellscript]": {
        "editor.defaultFormatter": "mkhl.shfmt",
        "editor.formatOnSave": true
    },
    // Taplo, as in Neovim; the repo's TOML files are already in its format
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml",
        "editor.formatOnSave": true
    },

    // === Terminal ===
    "terminal.integrated.defaultProfile.osx": "bash",
    "terminal.integrated.scrollback": 100000,

    // === Git ===
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,

    // === Workbench ===
    "workbench.startupEditor": "none",
    "workbench.editor.labelFormat": "short",

    // === Privacy ===
    "telemetry.telemetryLevel": "off",

    // === Claude Code ===
    "claudeCode.preferredLocation": "panel"
}
