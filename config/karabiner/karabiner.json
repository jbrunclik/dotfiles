            "complex_modifications": {
                "rules": [
                    {
                        "description": "CapsLock → Hyper (held) / Backspace (tapped; tap then hold to repeat)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "type": "expression_if",
                                        "expression": "caps_lock_tap_until > system.now.milliseconds"
                                    }
                                ],
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": {
                                        "optional": [
                                            "any"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "delete_or_backspace"
                                    }
                                ],
                                "to_if_alone": [
                                    {
                                        "set_variable": {
                                            "name": "caps_lock_tap_until",
                                            "expression": "system.now.milliseconds + 300"
                                        }
                                    }
                                ],
                                "to_delayed_action": {
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "caps_lock_tap_until",
                                                "value": 0
                                            }
                                        }
                                    ],
                                    "to_if_invoked": []
                                },
                                "parameters": {
                                    "basic.to_if_alone_timeout_milliseconds": 250
                                },
                                "type": "basic"
                            },
                            {
