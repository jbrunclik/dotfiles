# Ghostty Configuration
# Reload with Cmd+Shift+, — some settings need a new window

# --- Theme ---
# Auto-switches with macOS light/dark mode
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# --- Font ---
font-family = Maple Mono NF
font-size = 15
font-thicken = true
font-feature = dlig
adjust-cell-height = 2

# --- Window ---
window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-padding-color = extend
macos-titlebar-style = tabs
window-width = 140
window-height = 40
# Restore splits and tabs after a restart or reboot
window-save-state = always
# Treat Option as Meta so Alt readline bindings (Alt+B/F/D/., fzf Alt+C) work
macos-option-as-alt = true

# --- Background ---
background-opacity = 1

# --- Cursor ---
cursor-style = bar
cursor-style-blink = false

# --- Mouse ---
mouse-hide-while-typing = true

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# --- Quick Terminal (global hotkey) ---
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# --- Splits on the home row ---
# Alt+H/J/K/L moves between Ghostty splits, Ctrl+H/J/K/L between Neovim
# windows (keymaps.lua), so both stay on the home row without colliding. Ctrl
# can't do both: the shell and Claude Code need Ctrl+L and Ctrl+K. Physical
# key codes, so the Czech layout doesn't move them. The only thing given up
# is readline's Alt+L (downcase-word).
keybind = alt+key_h=goto_split:left
keybind = alt+key_j=goto_split:down
keybind = alt+key_k=goto_split:up
keybind = alt+key_l=goto_split:right
keybind = alt+shift+key_h=resize_split:left,40
keybind = alt+shift+key_j=resize_split:down,40
keybind = alt+shift+key_k=resize_split:up,40
keybind = alt+shift+key_l=resize_split:right,40
keybind = alt+key_z=toggle_split_zoom
keybind = alt+equal=equalize_splits

# --- Moving tabs ---
# Ctrl+,/. (the < > keys) move the current tab left/right — the keys
# Hyper+,/. switch tabs with. Free for the taking: legacy terminal encoding
# has no control character for , or ., so the shell, Neovim and Claude Code
# never see these chords, and Ghostty's own ,-shortcuts are on Cmd. Physical
# keys, as above.
keybind = ctrl+comma=move_tab:-1
keybind = ctrl+period=move_tab:1

# --- Shell integration (automatic, but explicit for clarity) ---
shell-integration = detect
# Keep TERMINFO through sudo, so root TUIs (sudo mtr, sudo btop) can find
# xterm-ghostty instead of failing with "Error opening terminal"
shell-integration-features = sudo

# --- Notifications ---
# Notify when a command finishes while Ghostty is not focused
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# --- Scrollback ---
scrollback-limit = 100000
